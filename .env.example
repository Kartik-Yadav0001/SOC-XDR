# SentinelX Environment Configuration
# Copy this file to .env and fill in actual values
# NEVER commit actual credentials to version control

# Application
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true

# Database
DATABASE_URL=postgresql://sentinelx:SentinelX!DB2026@localhost:5432/sentinelx

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# JWT Secrets (use strong random values in production)
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Threat Intelligence
THREAT_INTEL_API_KEY=

# Grafana
GRAFANA_PASSWORD=Grafana!2026